{
  "name": "discord-bot",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "clean": "rimraf dist/*",
    "copy:assets": "cpx 'src/**/*.{html,png,jpg,css,pug,svg,xlsx,gif,json}' 'dist/'",
    "start": "npm run build && node ./dist/index.js",
    "dev": "nodemon",
    "prebuild": "npm run clean",
    "build": "npx tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "postbuild": "npm run copy:assets"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vanlinh1602/discord-bot-template.git"
  },
  "keywords": [],
  "author": "xbot",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vanlinh1602/discord-bot-template.git/issues"
  },
  "homepage": "https://github.com/vanlinh1602/discord-bot-template.git#readme",
  "dependencies": {
    "async": "^3.2.6",
    "discord.js": "^14.24.0",
    "dotenv-flow": "^4.1.0",
    "glob": "^11.0.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/dotenv-flow": "^3.3.3",
    "@types/glob": "^9.0.0",
    "@types/lodash": "^4.17.20",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.9.1",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "cpx": "^1.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.17.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
